{
  "rewrites": [
    { "source": "/blogg/:slug*", "destination": "/blogg/index.html" },
    { "source": "/blog/:slug*", "destination": "/blog/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "xn--nordvxt-9wa.se" }],
      "destination": "https://nordvaxt.se/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.xn--nordvxt-9wa.se" }],
      "destination": "https://nordvaxt.se/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nordvaxt.se" }],
      "destination": "https://nordvaxt.se/:path*",
      "permanent": true
    },
    { "source": "/blog/:slug*", "destination": "/blogg/:slug*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
